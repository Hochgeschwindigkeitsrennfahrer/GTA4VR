diff --git a/src/d3d9/d3d9_device.cpp b/src/d3d9/d3d9_device.cpp
index 9b72bb2..a5e1a1c 100644
--- a/src/d3d9/d3d9_device.cpp
+++ b/src/d3d9/d3d9_device.cpp
@@ -3859,8 +3859,15 @@ namespace dxvk {
     // Don't unbind the buffer if the game sets a nullptr here.
     // Operation Flashpoint Red River breaks if we do that.
     // EndScene will clean it up if necessary.
-    if (buffer != nullptr)
-      BindIndices();
+    if (buffer != nullptr) {
+      // GTA4VR #013: PrepareDraw already binds a dirty index buffer before
+      // UploadIBO draws. Retain the API-state reference here, but omit queued
+      // bindings overwritten before that draw. UP draws own their binding.
+      if (m_d3d9Options.experimentalDeferIndexBindings)
+        m_dirty.set(D3D9DeviceDirtyFlag::IndexBuffer);
+      else
+        BindIndices();
+    }
 
     return D3D_OK;
   }
